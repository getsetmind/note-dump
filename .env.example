# note.com にログイン後、DevTools (F12) → Application → Cookies → https://note.com で
# 表示される「Cookie ヘッダ全体」をコピーして貼り付ける。
# 最低限 _note_session_v5 が必要。複数Cookieをまとめて貼ってOK。
NOTE_COOKIE="_note_session_v5=...; XSRF-TOKEN=...; ..."

# 出力先 (省略時は ./out)
OUT_DIR=./out

# 同時並行数
CONCURRENCY=2

# リクエスト間隔 (ms)、レートリミット回避用
REQUEST_DELAY_MS=600
