{
	"name": "note-dump",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dump": "bun run src/dump.ts",
		"dump:auto": "bun run src/dump.ts --mode=auto",
		"dump:file": "bun run src/dump.ts --mode=file",
		"dump:html": "bun run src/dump.ts --format=html",
		"dump:both": "bun run src/dump.ts --format=both",
		"cookie:cdp": "bun run scripts/get-cookie-cdp.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome check --write --unsafe ."
	},
	"dependencies": {
		"node-html-parser": "^7.1.0",
		"turndown": "^7.2.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "^1.3.13",
		"@types/turndown": "^5.0.6",
		"@yuu1111/biome-config": "^1.0.4",
		"@yuu1111/tsconfig": "^1.0.3",
		"typescript": "^6.0.3"
	}
}
